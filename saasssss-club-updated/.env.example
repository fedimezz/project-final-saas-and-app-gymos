# ── Required (the app refuses to boot without these) ─────────────────────────
DATABASE_URL=            # Neon POOLED url (host contains -pooler), ?sslmode=require
DIRECT_URL=              # Neon DIRECT url (no -pooler) — used by prisma migrate
JWT_SECRET=              # openssl rand -base64 48   (>= 32 chars)
APP_URL=https://yourdomain.com          # bare apex, no trailing slash
NEXT_PUBLIC_APP_URL=https://yourdomain.com   # same value as APP_URL

# ── Required in production in practice ───────────────────────────────────────
CRON_SECRET=             # openssl rand -hex 32  (>= 16 chars) — Vercel sends it to crons
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
RESEND_FROM=ClubX <no-reply@yourdomain.com>   # sender on a domain verified in Resend
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Platform bootstrap (used once by `prisma db seed`, then you may remove the password) ──
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=    # 12+ chars

# ── Card payments (skip = Stripe checkout disabled; manual payments still work) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Manual payments (Tunisia: transfer / D17 / Flouci / cash) ────────────────
# Shown to the owner after they file a request. Put your RIB / D17 number / WhatsApp here.
MANUAL_PAYMENT_INSTRUCTIONS="Virement RIB xx xxx xxxxxxxxxxxxxxx xx — ou D17 : 2x xxx xxx. Envoyez le reçu sur WhatsApp +216 xx xxx xxx."
PLATFORM_ALERT_EMAIL=    # you get an email for each new manual-payment request (falls back to SUPER_ADMIN_EMAIL)

# ── Mobile app download page (/download) ─────────────────────────────────────
NEXT_PUBLIC_ANDROID_APK_URL=      # e.g. a GitHub Release asset URL (https)
NEXT_PUBLIC_ANDROID_APK_VERSION=  # e.g. 1.0.0
NEXT_PUBLIC_IOS_TESTFLIGHT_URL=   # optional, needs an Apple Developer account

# ── Push notifications / optional ────────────────────────────────────────────
EXPO_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/callback/google
SMS_VERIFICATION_ENABLED=false
TEXTBEE_API_KEY=
