# ── Required (the app refuses to boot without these) ─────────────────────────
DATABASE_URL=            # Neon POOLED url (host contains -pooler), ?sslmode=require
DIRECT_URL=              # Neon DIRECT url (no -pooler) — used by prisma migrate
JWT_SECRET=              # openssl rand -base64 48   (>= 32 chars)
APP_URL=https://yourdomain.com          # bare apex, no trailing slash
NEXT_PUBLIC_APP_URL=https://yourdomain.com   # same value as APP_URL

# ── Required in production in practice ───────────────────────────────────────
CRON_SECRET=             # openssl rand -hex 32  (>= 16 chars) — Vercel sends it to crons
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
RESEND_FROM=ClubX <no-reply@yourdomain.com>   # sender on a domain verified in Resend
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Platform bootstrap (used once by `prisma db seed`, then you may remove the password) ──
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=    # 12+ chars

# ── Card payments (skip = Stripe checkout disabled; manual payments still work) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Checkout is used for monthly AND yearly plans (one payment per period, mode "payment").
# Webhook endpoint to register in Stripe: https://<APP_URL>/api/payments/stripe/webhook
#   events: checkout.session.completed, checkout.session.async_payment_succeeded,
#           checkout.session.async_payment_failed, checkout.session.expired
# A subscription is activated ONLY by that signed webhook (or by SUPER_ADMIN for an approved manual request).

# Auto-renewing card subscriptions (Stripe Subscriptions). OFF by default: every card payment is then a
# one-time payment for one period. Set to "true" only after testing in Stripe test mode, AND:
#   - enable the Stripe Customer Portal (Settings → Billing → Customer portal) so owners can cancel/update the card
#   - add these events to the webhook: invoice.paid, invoice.payment_failed, customer.subscription.deleted
STRIPE_RECURRING_ENABLED=

# Days a paid month/year stays usable after its end date before the club is suspended (0-30, default 3).
# Enforced on every request; /api/cron/subscription-renewal records it (status, e-mail, audit).
PAID_PERIOD_GRACE_DAYS=

# ── Manual payments (Tunisia: transfer / D17 / Flouci / cash) ────────────────
# Shown to the owner after they file a request. Put your RIB / D17 number / WhatsApp here.
MANUAL_PAYMENT_INSTRUCTIONS="Virement RIB xx xxx xxxxxxxxxxxxxxx xx — ou D17 : 2x xxx xxx. Envoyez le reçu sur WhatsApp +216 xx xxx xxx."
PLATFORM_ALERT_EMAIL=    # you get an email for each new manual-payment request (falls back to SUPER_ADMIN_EMAIL)

# Public contact mailbox shown in the landing footer (hidden when empty) and on the legal pages
NEXT_PUBLIC_CONTACT_EMAIL=
# Publisher identity shown on /legal/terms and /legal/privacy (complete before real customers)
LEGAL_ENTITY_NAME=       # e.g. "Fedi X — Entreprise individuelle"
LEGAL_ADDRESS=           # registered address
LEGAL_REGISTRATION=      # RNE / matricule fiscal

# ── Mobile app download page (/download) ─────────────────────────────────────
# The "Download APK" button appears ONLY when ALL of these are set (lib/app-release.ts). Leave them
# empty until you have a real release-signed APK installed and tested on a physical phone.
ANDROID_APK_URL=              # https URL of the .apk (GitHub Release asset or your own storage)
ANDROID_APK_VERSION=          # e.g. 1.0.0
ANDROID_APK_SHA256=           # output of: sha256sum clubx.apk
ANDROID_APK_SIGNED=           # set to "true" only for a release-signed build tested on a real device
ANDROID_APK_RELEASE_NOTES=    # short notes, items separated by "|"
ANDROID_APK_RELEASED_AT=      # optional, e.g. 2026-11-02
ANDROID_PLAY_URL=             # optional Google Play listing (needs a $25 one-time developer account)
NEXT_PUBLIC_IOS_TESTFLIGHT_URL=   # optional, needs an Apple Developer account

# ── Push notifications / optional ────────────────────────────────────────────
EXPO_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/callback/google
SMS_VERIFICATION_ENABLED=false
TEXTBEE_API_KEY=
