# Copy to .env.local for development (never commit .env.local).
# Release builds get this from eas.json / `eas env:create`, checked by scripts/check-release-env.mjs.
#
# Production: the bare https:// apex domain of your ClubX deployment (no path, no trailing slash).
# The app then talks to each club on its own subdomain (https://<club>.<apex>), which needs the
# wildcard DNS + certificate described in DEPLOYMENT.md.
EXPO_PUBLIC_PLATFORM_API_BASE_URL=https://yourdomain.com

# Development only (ignored in release builds): API of a club running on your LAN, e.g. http://192.168.1.20:3000
# EXPO_PUBLIC_DEV_CLUB_API_BASE_URL=
