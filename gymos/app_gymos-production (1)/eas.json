{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_PLATFORM_API_BASE_URL": "https://REPLACE-WITH-YOUR-APEX-DOMAIN" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_PLATFORM_API_BASE_URL": "https://REPLACE-WITH-YOUR-APEX-DOMAIN" }
    }
  },
  "submit": { "production": {} }
}
