# Copy to .env.local (gitignored) for local development, then restart Metro with `npx expo start -c`.
# Expo inlines EXPO_PUBLIC_* at bundle time — never put a secret in an EXPO_PUBLIC_ variable.

# Platform apex that serves /api/clubs/search.
#   Local backend on your LAN : http://192.168.X.X:3000   (phone + computer on the same Wi-Fi)
#   Production                : https://yourdomain.com     (HTTPS is REQUIRED in release builds)
EXPO_PUBLIC_PLATFORM_API_BASE_URL=http://192.168.X.X:3000

# Optional, dev only: force every club's API host to one local backend.
# EXPO_PUBLIC_DEV_CLUB_API_BASE_URL=http://192.168.X.X:3000
